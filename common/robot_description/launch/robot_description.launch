<?xml version="1.0"?>
<launch>
  <!-- ===================================================== -->
  <!-- Robot Description Launch -->
  <!-- URDF 로드 및 TF 발행만 담당 (Gazebo 스폰 제외) -->
  <!-- ===================================================== -->

  <!-- Argument for controlling odom TF publishing -->
  <arg name="publish_odom_tf" default="true"/>
  <arg name="publish_robot_tf" default="true"/>

  <!-- URDF 모델 로드 -->
  <param name="robot_description"
         command="$(find xacro)/xacro '$(find robot_description)/urdf/custom_description.urdf.xacro' publish_odom_tf:=$(arg publish_odom_tf)"/>

  <!-- Joint State Publisher: joint_states 발행 -->
  <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" output="screen" />

  <!-- Robot State Publisher: URDF 기반 TF 발행 -->
  <node if="$(arg publish_robot_tf)" name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>
  
</launch>
