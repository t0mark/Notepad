<launch>
  <arg name="debug" default="true"/>
  <arg name="lidar_topic" default="/ouster/points"/>
  <arg name="process_every_n_scans" default="5"/>
  <arg name="filtered_indices" default="[1]"/>

  <!-- FRNet 세그먼테이션 노드 -->
  <node name="frnet_node" pkg="api_navigation" type="frnet_node.py" output="screen">
    <remap from="pointcloud_in" to="$(arg lidar_topic)"/>
    <param name="config" value="$(find api_navigation)/config/pnc/frnet/frnet/frnet-school_seg.py"/>
    <param name="checkpoint" value="$(find api_navigation)/checkpoints/checkpoints.pth"/>
    <param name="process_every_n_scans" value="$(arg process_every_n_scans)"/>
    <rosparam param="filtered_indices" subst_value="True">$(arg filtered_indices)</rosparam>
  </node>
  
  <!-- Rviz 시각화 -->
  <node if="$(arg debug)" name="rviz" pkg="rviz" type="rviz"
        args="-d $(find api_navigation)/rviz/default.rviz"
        output="screen"/>
</launch>
